# Steamworks Web API Publisher Key
# Get from: https://partner.steamgames.com/doc/webapi_overview/auth
STEAMWORKS_API_KEY=your_publisher_key_here

# Financial API Group Key (required for IPartnerFinancialsService)
# Request from: Steamworks Partner > Users & Permissions > WebAPI
STEAMWORKS_FINANCIAL_KEY=your_financial_key_here

# App ID for testing (optional, can be passed per-request)
STEAM_APP_ID=480

# Partner API base URL (should not need to change)
STEAM_PARTNER_API_BASE=https://partner.steam-api.com
